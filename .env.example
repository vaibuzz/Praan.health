# ============================================================
# Praan Health – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio sandbox: whatsapp:+14155238886
# Production: whatsapp:+91XXXXXXXXXX (your approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Application ──────────────────────────────────────────────
# Set to your public domain in production (used to build /join/ links)
APP_BASE_URL=http://localhost:8000
YOUTUBE_REDIRECT_URL=https://www.youtube.com/live/YOUR_STREAM_ID

# ── Twilio Content Template SIDs ─────────────────────────────
# Replace with real Content Template SIDs from your Twilio Console
# (Messaging → Content → Templates)
TPL_ONBOARDING_STEP_2=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPL_MORNING_REMINDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPL_EVENING_REMINDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPL_MISSED_SESSION=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPL_REQUEST_FEEDBACK=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TPL_TRIAL_ENDED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
